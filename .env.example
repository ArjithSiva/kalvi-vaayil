VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false

# Frontend -> backend URL. Set this on Vercel to your Render service URL,
# e.g. https://kalvi-vaayil-backend.onrender.com (no trailing slash, no /api —
# the client appends /api itself). Leave it empty for local development, where
# the app falls back to a same-origin /api request.
VITE_API_URL=
